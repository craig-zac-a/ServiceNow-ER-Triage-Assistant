<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_ui_page">
    <sys_ui_page action="INSERT_OR_UPDATE">
        <category>general</category>
        <client_script><![CDATA[function saveNewPatient() {
  var ga = new GlideAjax('x_2206627_er_tri_0.ERTriagePatientAjax');
  ga.addParam('sysparm_name', 'createPatient');
  ga.addParam('sysparm_first', gel('np_first').value);
  ga.addParam('sysparm_last', gel('np_last').value);
  ga.addParam('sysparm_dob', gel('np_dob').value);
  ga.addParam('sysparm_sex', gel('np_sex').value);
  ga.getXMLAnswer(function(answer) {
    var r = JSON.parse(answer);
    if (!r.ok) {
      gel('np_error').innerHTML = r.error;
      return;
    }
    // The dialog's parent is the Encounter form
    var form = window.parent.g_form || g_form;
    form.setValue('patient', r.sys_id, r.display);
    GlideDialogWindow.get().destroy();
  });
}]]></client_script>
        <description/>
        <direct>false</direct>
        <endpoint>x_2206627_er_tri_0_er_new_patient_dialog.do</endpoint>
        <html><![CDATA[<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide">
  <table style="width:100%">
    <tr><td>First name *</td><td><input id="np_first" type="text" class="form-control"/></td></tr>
    <tr><td>Last name *</td><td><input id="np_last" type="text" class="form-control"/></td></tr>
    <tr><td>Date of birth *</td><td><input id="np_dob" type="date" class="form-control"/></td></tr>
    <tr><td>Sex</td><td>
      <select id="np_sex" class="form-control">
        <option value="">-- None --</option>
        <option value="female">Female</option>
        <option value="male">Male</option>
        <option value="other">Other</option>
        <option value="unknown">Unknown</option>
      </select></td></tr>
  </table>
  <div id="np_error" style="color:#c62828;margin:8px 0;"></div>
  <button type="button" class="btn btn-primary" onclick="saveNewPatient()">Create patient</button>
  <button type="button" class="btn btn-default" onclick="GlideDialogWindow.get().destroy()">Cancel</button>
</j:jelly>]]></html>
