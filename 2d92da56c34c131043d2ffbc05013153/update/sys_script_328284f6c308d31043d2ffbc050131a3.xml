        <script><![CDATA[(function executeRule(current, previous /*null when async*/)
{
	if(current.patient.nil()) return;

	var dobStr = current.patient.getRefRecord().getValue('date_of_birth');
	if(!dobStr) return;

	var arrival = current.arrival_time.nil() ? new GlideDateTime() : new GlideDateTime(current.getValue('arrival_time'));

	var arrStr = arrival.getLocalDate().getValue();
	var d = dobStr.split('-'), a = arrStr.split('-');
	var months = 	(parseInt(a[0], 10) - parseInt(d[0], 10)) * 12 +
					(parseInt(a[1], 10) - parseInt(d[1], 10));
	
	if(parseInt(a[2], 10) < parseInt(d[2], 10)) months--;

	if(months < 0)
	{
		gs.addErrorMessage('Date of birth is after the arrival time.');
		current.setAbortAction(true);
		return;
	}

	current.setValue('age_months', months);
	current.setValue('age_at_arrival', Math.floor(months/12));
})(current, previous);
]]></script>
